{
  "name": "icejardins-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:content && npm run build:search-index && vite",
    "build:content": "node scripts/build-content.mjs",
    "build:search-index": "node scripts/build-search-index.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run build:content && npm run build:search-index && npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "vite preview",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-ga4": "^3.0.1",
    "react-helmet-async": "^3.0.0",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "gray-matter": "^4.0.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2",
    "toml": "^5.0.0",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.0"
  }
}
