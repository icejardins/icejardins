# Google Service Account Credentials for Gmail API (Sending Form Leads)
# Option 1: Separate credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_PROJECT_ID="your-google-project-id"

# Option 2 (Alternative): Full JSON (raw or base64)
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# Sender email in Google Workspace to impersonate via Domain-Wide Delegation
GOOGLE_IMPERSONATED_USER="secretaria@icejardins.org.br"

# Destination email for new visitor notifications (defaults to secretaria@icejardins.org.br)
LEAD_NOTIFICATION_EMAIL="secretaria@icejardins.org.br"
